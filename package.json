{
  "name": "ayush-interactive-profile",
  "version": "6.8.0",
  "private": true,
  "description": "Native HTML/CSS/JavaScript recreation of Ayush\u2019s GitHub profile design",
  "scripts": {
    "start": "python -m http.server 3000 --bind 0.0.0.0",
    "build": "python scripts/bundle.py",
    "refresh": "python scripts/update_github.py",
    "test": "node tests/smoke.cjs",
    "test:motion": "node tests/motion.cjs",
    "test:fidelity": "node tests/fidelity.cjs",
    "test:display": "node tests/display.cjs",
    "test:credentials": "node tests/credentials.cjs",
    "test:modern": "node tests/modern.cjs",
    "refresh:leetcode": "python scripts/update_leetcode.py",
    "test:leetcode": "python -m unittest discover -s tests -p test_leetcode.py"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
